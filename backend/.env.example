# Environment configuration — copy to .env and fill in values.
# Do NOT commit .env to version control.

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# HTTP client timeout in seconds for all external API requests
HTTP_TIMEOUT=10.0

# External API base URLs (override only for testing/staging)
# OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
# NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
# NOMINATIM_USER_AGENT=EcoShelterAnalyzer/1.0

# ---------------------------------------------------------------------------
# Weather History Store (SQLite)
# ---------------------------------------------------------------------------
# Path to SQLite DB (relative to backend/). Use an absolute path in production.
# HISTORY_DB_PATH=app/data/weather_history.db
# HISTORY_TEMP_MIN=-60.0
# HISTORY_TEMP_MAX=60.0
# HISTORY_HTTP_TIMEOUT=30.0

# ---------------------------------------------------------------------------
# Backfill — Open-Meteo Historical Archive (free, no API key)
# ---------------------------------------------------------------------------
# OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
# BACKFILL_YEARS=3

# ---------------------------------------------------------------------------
# AutoML Backup Forecaster (FLAML)
# ---------------------------------------------------------------------------
# AUTOML_MIN_TRAINING_ROWS=90      # minimum rows before FLAML trains
# AUTOML_BACKTEST_DAYS=90          # rolling-origin backtest window
# AUTOML_FLAML_TIME_BUDGET=60      # seconds per target per horizon
# AUTOML_KEEP_VERSIONS=3           # keep last N model directories
# AUTOML_MODELS_DIR=app/data/automl_models

# ---------------------------------------------------------------------------
# Background Scheduler
# ---------------------------------------------------------------------------
# SCHEDULER_DAILY_INTERVAL_S=86400    # 24 h — daily data append
# SCHEDULER_RETRAIN_INTERVAL_S=604800 # 7 days — retrain check
# SCHEDULER_RETRAIN_NEW_DATA_ROWS=7   # new rows needed to trigger retrain
