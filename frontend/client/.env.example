# Backend API URL for EcoShelter platform
# Local development default: http://localhost:8000
# Production deployment: set to your deployed backend URL (e.g., https://ecoshelter-api.onrender.com)
# If using a reverse proxy where frontend & backend share the same domain (e.g. /api), this can be left blank.
VITE_API_BASE_URL=http://localhost:8000
